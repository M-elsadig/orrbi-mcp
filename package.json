{
  "name": "orrbi-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server that lets AI assistants book services at local businesses in Qatar via Orrbi.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:ui && tsx watch --env-file=.env src/dev.ts",
    "start": "npm run build:ui && tsx --env-file=.env src/dev.ts",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "build": "npm run build:ui && npm run typecheck",
    "vercel-build": "npm run build:ui",
    "test": "tsx --test test/*.test.ts",
    "create-system-user": "tsx --env-file=.env scripts/create-system-user.ts",
    "inspector": "npx @modelcontextprotocol/inspector",
    "set-telegram-webhook": "tsx --env-file=.env scripts/set-telegram-webhook.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@supabase/supabase-js": "^2.117.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
