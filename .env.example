# Supabase — the SAME project the Orrbi app uses (Settings → API).
# The service role key bypasses RLS: server-side only, never commit .env.
SUPABASE_URL=https://ycbmspmgyrbgwmybauos.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The auth user that owns all MCP bookings. Get it with: npm run create-system-user
ORRBI_MCP_USER_ID=

# Optional: n8n webhook that receives every new booking (business notification,
# WhatsApp confirmation). Leave empty to disable. A failing webhook never fails a booking.
N8N_WEBHOOK_URL=

# Optional: Telegram alert to the owner for every new MCP booking (includes customer phone).
# Token from @BotFather; chat id: message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id.
# Leave either empty to disable. A Telegram failure never fails a booking.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: comma-separated browser Origins allowed to call /mcp.
# Requests with no Origin header (server-to-server, e.g. Claude/ChatGPT connectors) are always allowed.
# Default: https://claude.ai,https://claude.com,https://chatgpt.com,https://chat.openai.com,http://localhost:6274,http://127.0.0.1:6274
ALLOWED_ORIGINS=

# Local dev port (npm run dev)
PORT=3000
